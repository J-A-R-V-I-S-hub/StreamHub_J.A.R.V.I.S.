# StreamHub J.A.R.V.I.S. - configurazione del connettore
#
# Copia questo file in .env e riempi i valori:
#   cp .env.example .env
#
# .env e' in .gitignore: i segreti non devono finire nel repository.
# Se XTREAM_PASSWORD resta vuota, `npm run init` non puo' generare la
# password per te: mettila a mano.

# ---------------------------------------------------------------------------
# Credenziali Xtream: sono queste che digiti in IBO Player Pro.
# Lascia XTREAM_PASSWORD vuota e il file semplice NON parte (errore chiaro).
# ---------------------------------------------------------------------------
XTREAM_USERNAME=
XTREAM_PASSWORD=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# La porta su cui ascolta l'app DENTRO il container.
# Nginx Proxy Manager la inoltra gia' su questa: se la cambi, devi
# cambiare anche la porta di forward nel proxy.
PORT=8080

# ---------------------------------------------------------------------------
# Gli indirizzi con cui il server si presenta al player
# ---------------------------------------------------------------------------
# Il player usa l'indirizzo annunciato per costruire gli indirizzi dei
# contenuti, quindi deve combiaciare con quello scritto nella playlist.
#
# LOCAL_URL   l'indirizzo del connettore SEMPLICE (quello di questa repo,
#             che gira in locale e fa le prove con i player)
# SERVER_URL  l'indirizzo del progetto SERIO (quello che gira in Docker
#             sul server: qui ci va il dominio pubblico)
#
# Ogni progetto legge la sua: il semplice LOCAL_URL, il serio SERVER_URL.
# Se la variabile del proprio progetto e' vuota, l'indirizzo viene dedotto
# da come il player chiama.
LOCAL_URL=
SERVER_URL=
PUBLIC_URL=

# Come viene consegnato il flusso al player:
#   1 = PROXY     il server scarica il file e lo passa al player.
#                  Il player deve raggiungere SOLO noi: robusto, e nel log si
#                  vede cosa chiede (Range, byte, ...).
#   0 = REDIRECT  il server risponde 302 e il player va a prendere il file
#                  direttamente dalla sorgente.
PROXY_STREAMS=1

# Log delle richieste (comodo per vedere cosa chiede il player).
# ACCESS_LOG=0 lo disattende.
ACCESS_LOG=1

# File su cui viene scritto il log delle richieste (lo legge `npm run logs`).
# LOG_FILE=/tmp/jarvis.log

# Messaggio di benvenuto mostrato dal player nei dettagli utente.
APP_MESSAGE=J.A.R.V.I.S. online - StreamHub

# ── Catalogo demo iniziale (opzionale) ───────────────────
# 1 = al primo avvio crea una linea demo con i film di pubblico dominio
# 0 = niente demo: il catalogo lo carica l'utente dalle sue sorgenti
SEED_DEMO=1
# Percorso alternativo del file di seed (JSON). Vuoto = quello incluso.
DEMO_SEED_FILE=

# Credenziali fisse della linea demo (comodo in sviluppo: la TV non va riconfigurata).
# Lasciare VUOTE in produzione: la demo nasce con credenziali casuali.
DEMO_LINE_USER=
DEMO_LINE_PASS=
