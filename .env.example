# StreamHub J.A.R.V.I.S. - configurazione del server SEMPLICE
#
# Copia questo file in .env e modifica i valori:
#   cp .env.example .env
#
# .env e' in .gitignore: i segreti non devono finire nel repository.
#
# Se XTREAM_PASSWORD resta vuota, `npm run init` non puo' generare la
# password per te: mettila a mano.

# ---------------------------------------------------------------------------
# Credenziali Xtream: sono queste che digiti in IBO Player Pro.
# Lascia XTREAM_PASSWORD vuota e il file semplice NON parte (errore chiaro).
# ---------------------------------------------------------------------------
XTREAM_USERNAME=Jarvis_Admin
XTREAM_PASSWORD=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8080

# Indirizzo pubblico del server (facoltativo).
# E' l'indirizzo che il server annuncia al player: mettici ESATTAMENTE quello
# che poi scrivi nel campo "Server" della playlist di IBO Player.
#
#   SERVER_URL=http://192.168.1.50:8080        (IP della rete locale)
#   SERVER_URL=https://streamhub.dominio.it    (URL pubblico)
#
# Lasciandolo vuoto, il server usa l'host con cui il player lo chiama:
# comodo in locale, ma se il player si collega in un modo diverso l'annuncio
# cambia. Con la TV, meglio fissarlo.
SERVER_URL=

# Come viene consegnato il flusso al player:
#   1 = PROXY     il server scarica il file e lo passa al player.
#                  Il player deve raggiungere SOLO noi: robusto, e nel log si
#                  vede cosa chiede (Range, byte, ...).
#   0 = REDIRECT  il server risponde 302 e il player va a prendere il file
#                  direttamente dalla sorgente.
PROXY_STREAMS=1

# Log delle richieste (comodo per vedere cosa chiede il player).
# ACCESS_LOG=0 lo disattende.
ACCESS_LOG=1

# File su cui viene scritto il log delle richieste (lo legge `npm run logs`).
# LOG_FILE=/tmp/jarvis.log

# Messaggio di benvenuto mostrato dal player nei dettagli utente.
# APP_MESSAGE=Ciao dal mio server di test

APP_MESSAGE=J.A.R.V.I.S. online - StreamHub
