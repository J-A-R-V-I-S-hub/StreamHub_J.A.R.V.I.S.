{
  "name": "streamhub-jarvis-simple",
  "version": "0.1.0",
  "private": true,
  "description": "Connettore Xtream Codes API in un file singolo, per collegare un player IPTV reale a un catalogo.",
  "main": "simple/server.js",
  "scripts": {
    "start": "node simple/server.js",
    "start:bg": "bash scripts/start-bg.sh start",
    "stop": "bash scripts/start-bg.sh stop",
    "init": "node scripts/init-env.js",
    "copy": "node scripts/copy-simple.js",
    "check": "node scripts/check-simple.js",
    "logs": "tail -f /tmp/jarvis.log",
    "tunnel": "bash scripts/start-tunnel.sh",
    "serve": "bash scripts/serve-public.sh",
    "hostname": "bash scripts/set-hostname.sh",
    "staticip": "bash scripts/set-static-ip.sh",
    "build:logo": "node scripts/embed-logo.js",
    "panel:build": "cd panel && flutter build web --release",
    "panel:up": "docker compose --profile panel up -d --build jarvis-panel",
    "panel:down": "docker compose --profile panel stop jarvis-panel"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT"
}
