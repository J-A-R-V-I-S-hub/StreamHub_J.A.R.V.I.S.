# Container del backend nuovo (server/).
# TypeScript eseguito direttamente da Node: nessun passo di build.
FROM node:24-alpine

WORKDIR /app

# Dipendenze prima del codice: il layer resta in cache se cambia solo src/
COPY server/package.json server/package-lock.json ./
RUN npm ci --omit=dev

COPY server/src ./src
COPY server/seed ./seed

ENV NODE_ENV=production
ENV PORT=8080
ENV DATABASE_PATH=/app/data/streamhub.db
ENV TZ=Europe/Rome

# Il database vive qui: deve essere un volume, altrimenti sparisce a ogni rebuild.
RUN mkdir -p /app/data

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s \
  CMD wget -qO- http://127.0.0.1:${PORT:-8080}/health >/dev/null || exit 1

CMD ["node", "src/main.ts"]
